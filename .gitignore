# ===== 环境与配置 =====
.env
*.env.local

# ===== 运行时数据 =====
data/
data-test/
*.iso
*.iso.*
# sidecar 凭据目录(明文口令/配置): 运行时由容器生成, 绝不能入库
samba-config/
webdav-config/
qb-config/

# ===== Python =====
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# ===== 系统 =====
.DS_Store
Thumbs.db

# ===== 编辑器 =====
.idea/
.vscode/.git_commit_msg.txt
.workbuddy_push.py
.workbuddy_e2e_*.py
.workbuddy_*.py

# ===== 开发过程产物(不入库) =====
# agentic 工作概述 / QA 验证报告: 含本地绝对路径, 对使用者无价值
overview.md
QA_REPORT_*.md
# 本机跑测试时的 ISO_DATA_DIR 落地目录(测试会往里写 gpg_ledger.json 等),
# 之前漏了这条 —— 跑一次测试就会多出一个待提交的空目录
.tmp-data/

# 运行期状态文件: 若有人把 ISO_DATA_DIR 指到仓库根目录(本地调试), 这些会落在根目录。
# 它们描述的是"本机数据卷的状态", 不是源码。
/download_unverified.json
/download_failures.json
/gpg_ledger.json
/settings.json
/distributions.json
# 跨进程锁的边车文件(M3): 上面这些账本被锁时, 旁边会出现 <name>.lock。
# 内容是 1 字节种子, 只用于加锁, 没有任何状态, 绝不入库。
/download_unverified.json.lock
/download_failures.json.lock
