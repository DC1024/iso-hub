# ===== ISO Hub 可配置环境变量 =====
# 复制为 .env 后按需修改 (docker compose 自动读取)

# 网页/API 端口 (默认 8899)
ISO_HUB_PORT=8899

# 访问令牌 (不设则不鉴权; 建议内网也设置)
ISO_HUB_TOKEN=

# 订阅自动同步间隔(秒) 86400=每天; 0=关闭自动调度
ISO_HUB_SYNC_INTERVAL=86400

# 多源选源策略: A=固定优先级(默认, 按配置顺序: 国内清华在前/官方兜底), B=实测选最快可达源
ISO_HUB_SOURCE_STRATEGY=A

# pip 镜像(构建时用)
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ---- SMB 共享 (PVE/Windows 挂载用) ----
SAMBA_PORT=445
SAMBA_USER=iso
SAMBA_PASS=iso123

# ---- WebDAV 共享 (http://IP:8081/dav) ----
WEBDAV_PORT=8081
WEBDAV_USER=iso
WEBDAV_PASS=iso123