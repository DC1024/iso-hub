# ===== ISO Hub 可配置环境变量 =====
# 复制为 .env 后按需修改 (docker compose 自动读取)

# 网页/API 端口 (默认 8899)
ISO_HUB_PORT=8899

# 访问令牌 (不设则不鉴权; 建议内网也设置)
# ⚠️ 安全提示: 若公网部署, 务必设置 ISO_HUB_TOKEN 或保持 ISO_HUB_REQUIRE_LOGIN=1
ISO_HUB_TOKEN=

# 强制登录门禁: 1=必须登录管理员账号才能使用(默认开, 更安全); 0=关闭登录门禁(仅限可信内网)
# ⚠️ 公网部署务必保持 1
ISO_HUB_REQUIRE_LOGIN=1

# 管理员账号播种: 首次启动(用户表为空)时自动创建该账号
# ⚠️ 公网部署务必设置: 不设的话公网打开登录页会报"管理员账号未设置"(防抢注, 仅允许本机建号)
# 同名账号已存在时不覆盖; 账号建好后改这里重启不会改密码, 改密走面板「设置→修改密码」
ISO_HUB_ADMIN_USER=
ISO_HUB_ADMIN_PASS=

# 订阅自动同步间隔(秒) 86400=每天; 0=关闭自动调度
ISO_HUB_SYNC_INTERVAL=86400

# 多源选源策略: A=固定优先级(默认, 按配置顺序: 国内清华在前/官方兜底), B=实测选最快可达源
ISO_HUB_SOURCE_STRATEGY=A

# pip 镜像(构建时用)
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# Docker Engine API 访问方式(compose 已内置, 一般无需改动):
#   tcp://socket-proxy:2375 = 经 socket-proxy 白名单访问(默认, 主容器不持有裸 sock)
#   留空/不设            = 回退 Unix socket /var/run/docker.sock(旧版行为, 向后兼容)
# DOCKER_HOST=tcp://socket-proxy:2375

# ---- SMB/WebDAV 共享 (需启用 compose profile "share": docker compose --profile share up -d) ----
# 未启用 profile 时容器不创建、镜像不拉取; 启用后可在 iso-hub 面板「设置→共享」实时启停并改账号密码。
# 以下值仅作为首次启用前的兜底默认值, 生产环境务必在面板中修改。
SAMBA_PORT=445
SAMBA_USER=iso
SAMBA_PASS=CHANGE_ME_PLEASE

WEBDAV_PORT=8081
WEBDAV_USER=iso
WEBDAV_PASS=CHANGE_ME_PLEASE

# ---- qBittorrent 种子下载 sidecar (需启用 compose profile "bt": docker compose --profile bt up -d) ----
# 未启用 profile 时容器不创建、镜像不拉取; 启用后可在 iso-hub 面板「设置→qBittorrent」实时启停并改账号密码。
# 以下值仅作为首次启用前的兜底默认值, 启用后务必在面板中修改。
QB_USER=admin
QB_PASS=CHANGE_ME_PLEASE